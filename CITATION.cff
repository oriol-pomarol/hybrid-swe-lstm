    given-names: "Oriol"
    affiliation: "Utrecht University"
    orcid: "https://orcid.org/0009-0000-2222-9365"
version: 1.0.0
license: MIT
keywords:
  - snow water equivalent
  - LSTM
  - hybrid modelling
  - machine learning
  - ERA5-Land
  - Northern Hemisphere
